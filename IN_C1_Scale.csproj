<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>IN_C1_Scale</AssemblyName>
    <RootNamespace>InC1Scale</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <!-- Do not generate IN_C1_Scale.exe.config: the output must be the single EXE -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets .NET Framework call the Windows 10 Bluetooth LE API -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
  </ItemGroup>

</Project>
